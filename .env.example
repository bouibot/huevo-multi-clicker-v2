# скопируй в .env и заполни: cp .env.example .env
BOT_TOKEN=123456:ABC-DEF...  # токен бота от @BotFather
OWNER_ID=123456789           # Telegram id владельца бота: единственный, кто может добавлять/удалять админов
# опционально:
# ADMIN_ID=123456789         # старое имя OWNER_ID, всё ещё работает (если OWNER_ID не задан)
# HUE_BASE=https://huevo.su  # адрес сайта (не меняй без нужды)
# DATA_DIR=./data            # где хранить SQLite (data/clicker.db)
